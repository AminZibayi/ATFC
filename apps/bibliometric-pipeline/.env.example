# Technology Forecasting Pipeline - Environment Variables
# Copy this file to .env and adjust the values as needed.

# --- Graph Building Configuration ---
# GRAPH_MIN_WEIGHT: The minimum weight (co-occurrence count) an edge must have to be kept.
# A higher value prunes the graph more aggressively, removing infrequent collaborations or co-occurrences.
# Set to 0 to keep all edges (can result in very large files).
GRAPH_MIN_WEIGHT=1

# GRAPH_REMOVE_ISOLATES: Whether to remove nodes that have no connecting edges after pruning.
# Set to "true" (default) or "false".
GRAPH_REMOVE_ISOLATES=true
