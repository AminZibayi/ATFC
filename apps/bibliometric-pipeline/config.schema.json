{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bibliometric Pipeline Configuration",
  "description": "Configuration file for the bibliometric data processing and layout pipeline.",
  "type": "object",
  "definitions": {
    "layout_override": {
      "type": "object",
      "description": "Optional per-section layout override. Only 'algorithm' and 'iterations' are supported here.",
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["pyforceatlas2", "fa2", "sfdp", "yifan_hu"],
          "description": "Override the global layout algorithm for this graph type."
        },
        "iterations": {
          "type": "integer",
          "description": "Override the global iteration count for this graph type."
        }
      },
      "additionalProperties": false
    },
    "graph_config": {
      "type": "object",
      "properties": {
        "min_weight": {
          "type": "integer",
          "description": "The minimum weight (co-occurrence count) an edge must have to be kept.",
          "default": 1
        },
        "remove_isolates": {
          "type": "boolean",
          "description": "Whether to remove nodes that have no connecting edges after pruning.",
          "default": false
        },
        "layout": {
          "$ref": "#/definitions/layout_override"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "default": {
      "type": "object",
      "description": "Default graph settings applied to all graph types unless overridden.",
      "properties": {
        "min_weight": {
          "type": "integer",
          "description": "The minimum weight (co-occurrence count) an edge must have to be kept.",
          "default": 1
        },
        "remove_isolates": {
          "type": "boolean",
          "description": "Whether to remove nodes that have no connecting edges after pruning.",
          "default": false
        },
        "layout": {
          "$ref": "#/definitions/layout_override"
        }
      },
      "additionalProperties": false
    },
    "co_author": {
      "$ref": "#/definitions/graph_config"
    },
    "co_funding": {
      "$ref": "#/definitions/graph_config"
    },
    "co_affiliation": {
      "$ref": "#/definitions/graph_config"
    },
    "author_keywords": {
      "$ref": "#/definitions/graph_config"
    },
    "wos_categories": {
      "$ref": "#/definitions/graph_config"
    },
    "layout": {
      "type": "object",
      "description": "Global layout engine configuration.",
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["pyforceatlas2", "fa2", "sfdp", "yifan_hu"],
          "description": "The layout algorithm to use.",
          "default": "pyforceatlas2"
        },
        "iterations": {
          "type": "integer",
          "description": "Number of iterations. Omit to enable dynamic scaling based on graph size.",
          "default": 2000
        },
        "forceatlas2": {
          "type": "object",
          "description": "Parameters specific to the ForceAtlas2 engines (pyforceatlas2, fa2).",
          "properties": {
            "scaling_ratio": { "type": "number", "default": 2.0 },
            "gravity": { "type": "number", "default": 1.0 },
            "edge_weight_influence": { "type": "number", "default": 1.0 },
            "jitter_tolerance": { "type": "number", "default": 1.0 },
            "barnes_hut_optimize": { "type": "boolean", "default": true },
            "barnes_hut_theta": { "type": "number", "default": 1.2 },
            "lin_log_mode": { "type": "boolean", "default": false },
            "strong_gravity_mode": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        },
        "sfdp": {
          "type": "object",
          "description": "Parameters specific to the Graphviz SFDP / Yifan Hu engine.",
          "properties": {
            "K": { "type": "number", "default": 1.0 },
            "overlap": {
              "type": "string",
              "enum": ["true", "false", "scale", "prism", "orthoxy", "orthoyx", "compress"],
              "default": "prism"
            },
            "repulsiveforce": { "type": "number", "default": 1.0 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
