{
  "name": "bibliometric-pipeline",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/bibliometric-pipeline/src",
  "targets": {
    "extract": {
      "command": "uv run python -m bibliometric_pipeline.etl.extract",
      "options": { "cwd": "apps/bibliometric-pipeline" },
      "inputs": [
        "{workspaceRoot}/data/raw/**"
      ],
      "outputs": [
        "{workspaceRoot}/data/intermediate/bibliometric-pipeline"
      ],
      "cache": true
    },
    "transform": {
      "command": "uv run python -m bibliometric_pipeline.etl.transform",
      "dependsOn": ["extract"],
      "options": { "cwd": "apps/bibliometric-pipeline" },
      "inputs": [
        "{workspaceRoot}/data/intermediate/bibliometric-pipeline/records.parquet"
      ],
      "outputs": [
        "{workspaceRoot}/data/intermediate/bibliometric-pipeline"
      ],
      "cache": true
    },
    "load": {
      "command": "uv run python -m bibliometric_pipeline.etl.load",
      "dependsOn": ["transform"],
      "options": { "cwd": "apps/bibliometric-pipeline" },
      "inputs": [
        "{workspaceRoot}/data/intermediate/bibliometric-pipeline"
      ],
      "outputs": [
        "{workspaceRoot}/data/outputs/bibliometric-pipeline/graphs"
      ],
      "cache": true
    },
    "run": {
      "command": "uv run python -m bibliometric_pipeline.main",
      "dependsOn": ["load"],
      "options": { "cwd": "apps/bibliometric-pipeline" },
      "cache": false
    }
  }
}