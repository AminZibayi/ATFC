{
  "name": "bibliometric-pipeline",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/bibliometric-pipeline/src",
  "targets": {
    "extract": {
      "command": "uv run python -u -m bibliometric_pipeline.etl.extract",
      "options": { "cwd": "apps/bibliometric-pipeline" },
      "inputs": ["{workspaceRoot}/data/raw/**"],
      "outputs": ["{workspaceRoot}/data/intermediate/bibliometric-pipeline"],
      "cache": true
    },
    "build-graphs": {
      "command": "uv run python -u -m bibliometric_pipeline.etl.build_graphs",
      "dependsOn": ["extract"],
      "options": { "cwd": "apps/bibliometric-pipeline" },
      "inputs": [
        "{workspaceRoot}/data/intermediate/bibliometric-pipeline/records.parquet",
        "{projectRoot}/src/bibliometric_pipeline/etl/build_graphs.py",
        "{projectRoot}/src/bibliometric_pipeline/graphs/builders.py"
      ],
      "outputs": ["{workspaceRoot}/data/outputs/bibliometric-pipeline/graphs"],
      "cache": true
    },
    "apply-layout": {
      "command": "uv run python -u -m bibliometric_pipeline.etl.apply_layout",
      "dependsOn": ["build-graphs"],
      "options": { "cwd": "apps/bibliometric-pipeline" },
      "inputs": [
        "{workspaceRoot}/data/outputs/bibliometric-pipeline/graphs",
        "{projectRoot}/src/bibliometric_pipeline/etl/apply_layout.py",
        "{projectRoot}/src/bibliometric_pipeline/layout/compute.py"
      ],
      "outputs": ["{workspaceRoot}/data/outputs/bibliometric-pipeline/graphs"],
      "cache": true
    },
    "run": {
      "executor": "nx:noop",
      "dependsOn": ["apply-layout"]
    }
  }
}
