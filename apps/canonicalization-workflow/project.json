{
  "name": "canonicalization-workflow",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/canonicalization-workflow/src",
  "targets": {
    "fetch-vocabularies": {
      "command": "uv run python -u -m canonicalization_workflow.fetch_vocabularies",
      "options": { "cwd": "apps/canonicalization-workflow" },
      "inputs": [
        "{projectRoot}/src/canonicalization_workflow/fetch_vocabularies.py"
      ],
      "outputs": ["{workspaceRoot}/data/intermediate/canonicalization-workflow/vocabularies"],
      "cache": true
    },
    "canonicalize-keywords": {
      "command": "uv run python -u -m canonicalization_workflow.canonicalize_keywords",
      "dependsOn": ["fetch-vocabularies", "bibliometric-pipeline:extract"],
      "options": { "cwd": "apps/canonicalization-workflow" },
      "inputs": [
        "{projectRoot}/src/canonicalization_workflow/canonicalize_keywords.py",
        "{workspaceRoot}/data/intermediate/canonicalization-workflow/vocabularies",
        "{workspaceRoot}/data/intermediate/bibliometric-pipeline/records.parquet"
      ],
      "outputs": ["{workspaceRoot}/data/outputs/canonicalization-workflow"],
      "cache": true
    },
    "lock": {
      "executor": "@nxlv/python:lock",
      "options": {
        "update": false
      }
    },
    "sync": {
      "executor": "@nxlv/python:sync",
      "options": {}
    },
    "add": {
      "executor": "@nxlv/python:add",
      "options": {}
    },
    "update": {
      "executor": "@nxlv/python:update",
      "options": {}
    },
    "remove": {
      "executor": "@nxlv/python:remove",
      "options": {}
    },
    "build": {
      "executor": "@nxlv/python:build",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "outputPath": "{projectRoot}/dist",
        "publish": false,
        "lockedVersions": true,
        "bundleLocalDependencies": true
      },
      "cache": true
    },
    "lint": {
      "executor": "@nxlv/python:ruff-check",
      "outputs": [],
      "options": {
        "lintFilePatterns": [
          "src",
          "tests"
        ]
      },
      "cache": true
    },
    "format": {
      "executor": "@nxlv/python:ruff-format",
      "outputs": [],
      "options": {
        "filePatterns": [
          "src",
          "tests"
        ]
      },
      "cache": true
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "outputs": [
        "{workspaceRoot}/reports/{projectRoot}/unittests",
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "command": "uv run pytest tests/",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "install": {
      "executor": "@nxlv/python:install",
      "options": {
        "silent": false,
        "args": "",
        "verbose": false,
        "debug": false
      }
    }
  },
  "tags": [],
  "release": {
    "version": {
      "versionActions": "@nxlv/python/release/version-actions"
    }
  }
}
